# 复制本文件为 .env.local 并填入真实 Key（.env.local 已被 .gitignore 忽略，不会提交）
#
# DeepSeek API Key —— 获取地址：https://platform.deepseek.com
# 用于 src/services/api.ts 与 tests/integration/api-real.test.ts
VITE_DEEPSEEK_API_KEY=

# 可选：模型名，默认 deepseek-flash
# 该 Key 可用模型：deepseek-flash、deepseek-v4-pro
VITE_DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 以下三项**留空即使用代码里的安全默认值**，只有需要覆盖时才填：
# 读取逻辑见 src/config/evalConfig.ts（ENV_FLAG 语义：只有 'true' / '1' 视为开）
# ---------------------------------------------------------------------------

# offline（默认）= 不允许真实 LLM 调用；live = 允许（真实评测请显式指定）
# 注意：目前 api.ts 尚未接入该 gate，真实调用的隔离由测试侧保证（见 evalConfig.ts 注释）
VITE_EVAL_MODE=offline

# RAG 检索 + 上下文注入，默认 false（阶段 2 交付后再开，见实施计划 S4-R1）
VITE_RAG_ENABLED=false

# 真实接口测试开关：只在 `npm run test:api` 与 CI 的手动 live-eval job 里用到
# 不设时 tests/integration/api-real.test.ts 整组 skip（`npm test` 不会消耗额度）
LLM_E2E=
