{
  "name": "learning-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:report": "vitest run && tsx scripts/gen-test-report.ts",
    "typecheck": "tsc -b",
    "golden:build": "tsx scripts/gen-golden-dataset.ts",
    "golden:check": "tsx scripts/gen-golden-dataset.ts --check",
    "vectors:build": "tsx scripts/build-vectors.ts",
    "threshold:tune": "tsx scripts/tune-threshold.ts",
    "rag:queries": "tsx scripts/gen-rag-queries.ts",
    "eval:rag": "vitest run tests/eval/rag-eval.test.ts",
    "eval:report": "tsx scripts/gen-eval-report.ts",
    "eval:golden": "vitest run tests/eval/runGoldenEval.test.ts",
    "measure:size": "node scripts/measure-entry-size.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "tests/golden/*.json": "node scripts/check-json.mjs",
    "src/data/rag*.json": "node scripts/check-json.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "antd": "^6.3.5",
    "axios": "^1.15.0",
    "dayjs": "^1.11.20",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "mammoth": "^1.12.0",
    "msw": "^2.14.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.8"
  }
}
